PORT=3000

# Integração Pulse Direct (NÃO exponha este token no frontend)
PULSE_API_URL=url_base_da_api_pulse_direct
PULSE_API_TOKEN=coloque_o_token_aqui

# Postgres (ex.: Supabase via pooler em modo transação, porta 6543)
DATABASE_URL=postgres://usuario:senha@host:6543/postgres

ADMIN_EMAILS=
OFFLINE_STATUS=Blocked
TZ_OFFSET_MINUTES=-180
SESSION_HOURS=12
SYNC_MINUTES=10
DRY_RUN=false
COOKIE_SECURE=false
CRON_SECRET=gere_um_valor_aleatorio
