PORT=3000

# Integração Pulse Direct (NÃO exponha este token no frontend)
PULSE_API_URL=url_base_da_api_pulse_direct
PULSE_API_TOKEN=coloque_o_token_aqui

# Postgres (ex.: Supabase via pooler em modo transação, porta 6543)
DATABASE_URL=postgres://usuario:senha@host:6543/postgres

ADMIN_EMAILS=
TZ_OFFSET_MINUTES=-180
SESSION_HOURS=12
SYNC_MINUTES=10
DRY_RUN=false
COOKIE_SECURE=false
CRON_SECRET=gere_um_valor_aleatorio

# Distribuição automática (/distribuicao) — fica DESLIGADA até um admin ligar na tela
# Base de conversas da API; vazio = PULSE_API_URL trocando o final /core por /chat
PULSE_CHAT_API_URL=
# Segredo da URL de eventos do Pulse Direct (POST /api/distribuicao/evento?token=…)
DISTRIBUICAO_SEGREDO=gere_outro_valor_aleatorio
# Teto de requisições do sistema a cada 5 min (a conta inteira tem 1.000, compartilhadas)
DISTRIBUICAO_ORCAMENTO_5MIN=250
# Só para banco local de desenvolvimento/testes (sem SSL)
# DB_SSL=disable
