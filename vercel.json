{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["gru1"],
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "db/distribuicao.sql" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/distribui(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/sync", "schedule": "0 9 * * *" }]
}
